(() => {
  const scriptUrl=document.currentScript?.src || new URL('assets/site.js',location.href).href;
  const stage=document.getElementById('graph-stage');
  const loading=document.getElementById('graph-loading');
  const style=document.createElement('style');
  style.id='giar-rev69-hard-loading';
  style.textContent=`
    .graph-stage.giar-bootstrap-hold .graph-cy,
    .graph-stage.giar-bootstrap-hold .graph-person-label-layer,
    .graph-stage.giar-bootstrap-hold .graph-person-lines,
    .graph-stage.giar-bootstrap-hold .graph-person-desktop-layer,
    .graph-stage.giar-bootstrap-hold .graph-person-desktop-lines,
    .graph-stage.giar-bootstrap-hold .graph-toolbar,
    .graph-stage.giar-bootstrap-hold .graph-help{visibility:hidden!important}
    .graph-stage.giar-bootstrap-hold .graph-loading{opacity:1!important;background:#f7f4ee!important;z-index:30!important}
  `;
  document.head.appendChild(style);

  if(stage&&loading){
    stage.classList.add('giar-bootstrap-hold');
    loading.classList.remove('is-hidden');
    loading.style.background='#f7f4ee';
    loading.style.opacity='1';
    const revealObserver=new MutationObserver(()=>{
      if(loading.classList.contains('is-hidden')){
        stage.classList.remove('giar-bootstrap-hold');
        revealObserver.disconnect();
      }
    });
    revealObserver.observe(loading,{attributes:true,attributeFilter:['class']});
  }

  const real=document.createElement('script');
  real.src=new URL('site-rev68.js?v=69',scriptUrl).href;
  real.async=false;
  document.head.appendChild(real);
})();
