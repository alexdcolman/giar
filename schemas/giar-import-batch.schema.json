{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giar.local/schema/import-batch-0.1.json",
  "title": "GIAR import batch 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "received_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "supplied_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "source_kind"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string",
            "minLength": 1
          },
          "original_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "context_note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
